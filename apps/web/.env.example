# All keys are optional and free. Without any, everything works with on-device fallbacks.
# Keys stay on the server; the browser never sees them.

# Groq (tried first): free key from https://console.groq.com/keys (no billing required).
# Powers the coach chat, the daily coach note and meal photo estimates.
GROQ_API_KEY=

# Gemini (fallback, and the only provider for live voice): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GROQ_MODELS=openai/gpt-oss-120b   (picked automatically from what your key can use)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
